{
    "name": "gembooking-simple-booking-form",
    "version": "0.1.0",
    "description": "GemBooking Simple Booking Form",
    "main": "index.js",
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "dist": "node build-tools/build.mjs",
        "dist:zip": "node build-tools/build.mjs --only=zip",
        "dist:wporg": "node build-tools/build.mjs --distignore=.distignore-wporg",
        "wp:pot": "wp i18n make-pot . languages/gembooking-simple-booking-form.pot --domain=gembooking-simple-booking-form --exclude=node_modules,vendor,build-tools,docs,tests,languages,assets/build --skip-audit",
        "check-engines": "wp-scripts check-engines",
        "format": "wp-scripts format",
        "lint:css": "wp-scripts lint-style",
        "lint:js": "wp-scripts lint-js",
        "lint:pkg-json": "wp-scripts lint-pkg-json",
        "test:unit": "wp-scripts test-unit-js",
        "test:php": "php tests/php/run.php"
    },
    "author": "Kodezen",
    "license": "GPL-2.0-or-later",
    "devDependencies": {
        "@wordpress/scripts": "^37.1.0",
        "archiver": "^8.0.0",
        "ignore": "^7.0.14",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    }
}
